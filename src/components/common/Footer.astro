---
import { getWhatsAppLink } from "@/config/contact";
const productLinks = [
  { label: "Varón", href: getWhatsAppLink({ kind: "category", category: "Varón" }) },
  { label: "Dama", href: getWhatsAppLink({ kind: "category", category: "Dama" }) },
  { label: "Niños", href: getWhatsAppLink({ kind: "category", category: "Niños" }) },
];

const companyLinks = [
  { label: "Nosotros", href: "#nosotros" },
  { label: "Mayoristas", href: "#mayoristas" },
  { label: "Contacto", href: "#contacto" },
];

const socialLinks = [
  { label: "Instagram" },
  { label: "Facebook" },
  { label: "TikTok" },
];

const currentYear = new Date().getFullYear();
---

<!-- Transición visual hacia el footer -->
<div
  class="
    relative h-12
    overflow-hidden
    bg-brand-950
    sm:h-14
    lg:h-16
  "
  aria-hidden="true"
>
  <!-- Plano azul principal -->
  <div
    class="
      absolute inset-y-0 right-0
      w-[72%]
      bg-accent-600
    "
    style="
      clip-path: polygon(
        18% 0,
        100% 0,
        100% 100%,
        0 100%
      );
    "
  ></div>

  <!-- Plano azul secundario -->
  <div
    class="
      absolute inset-y-0 right-0
      w-[48%]
      bg-accent-500
    "
    style="
      clip-path: polygon(
        28% 0,
        100% 0,
        100% 100%,
        0 100%
      );
    "
  ></div>

  <!-- Acento -->
  <div
    class="
      absolute inset-y-0 right-0
      w-[24%]
      bg-accent-400/70
    "
    style="
      clip-path: polygon(
        40% 0,
        100% 0,
        100% 100%,
        0 100%
      );
    "
  ></div>
</div>

<footer
  id="contacto"
  class="bg-[#020b14] text-white"
  aria-label="Pie de página"
>
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">

    <!-- CONTENIDO PRINCIPAL -->
    <div
      class="
        grid gap-10
        py-10
        sm:py-12
        lg:grid-cols-[1.4fr_0.7fr_0.7fr_1fr]
        lg:gap-12 lg:py-14
      "
    >

      <!-- MARCA -->
      <div>
        <!--
          ESPACIO RESERVADO PARA LOGO.
          Después reemplazaremos este bloque por <Image />.
        -->
        <div
          class="
            flex h-10 w-36
            items-center
            font-heading text-2xl font-black
            tracking-tight text-white
          "
          aria-label="LIONSUN"
        >
          LIONSUN
        </div>

        <p
          class="
            mt-4 max-w-xs
            text-sm leading-6
            text-neutral-300
          "
        >
          Pasos que te llevan más lejos.
        </p>

        <!-- Redes pendientes: conservar estructura oculta hasta confirmar las URLs. -->
        <nav
          hidden
          class="mt-6"
          aria-label="Redes sociales"
        >
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            {
              socialLinks.map((social) => (
                <li>
                  <span class="text-xs font-semibold text-neutral-300" title="URL oficial pendiente de confirmar">
                    {social.label}<span class="sr-only"> (URL oficial pendiente de confirmar)</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>


      <!-- PRODUCTOS -->
      <nav aria-labelledby="footer-products">
        <h2
          id="footer-products"
          class="
            text-xs font-bold uppercase
            tracking-[0.18em]
            text-white
          "
        >
          Productos
        </h2>

        <ul class="mt-4 space-y-3">
          {
            productLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="
                    text-sm text-neutral-300
                    transition-colors
                    hover:text-accent-400
                  "
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>


      <!-- EMPRESA -->
      <nav aria-labelledby="footer-company">
        <h2
          id="footer-company"
          class="
            text-xs font-bold uppercase
            tracking-[0.18em]
            text-white
          "
        >
          Empresa
        </h2>

        <ul class="mt-4 space-y-3">
          {
            companyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="
                    text-sm text-neutral-300
                    transition-colors
                    hover:text-accent-400
                  "
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>


      <!-- CONTACTO -->
      <div>
        <h2
          class="
            text-xs font-bold uppercase
            tracking-[0.18em]
            text-white
          "
        >
          Contacto
        </h2>

        <address
          class="
            mt-4 space-y-3
            text-sm not-italic
            text-neutral-300
          "
        >
          <p>
            Lima, Perú
          </p>

          <p>
            <a
              href="mailto:contacto@lionsun.pe"
              class="
                transition-colors
                hover:text-accent-400
              "
            >
              contacto@lionsun.pe
            </a>
          </p>

          <p>
            <a
              href={getWhatsAppLink()}
              class="
                inline-flex items-center gap-2
                font-bold text-white
                transition-colors
                hover:text-whatsapp-500
              "
              aria-label="Contactar a LIONSUN por WhatsApp"
            >
              WhatsApp
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </address>
      </div>

    </div>


    <!-- BARRA INFERIOR -->
    <div
      class="
        flex flex-col gap-3
        border-t border-white/10
        py-5
        text-xs text-neutral-400
        sm:flex-row
        sm:items-center sm:justify-between
      "
    >
      <p>
        © {currentYear} LIONSUN. Todos los derechos reservados.
      </p>

      <div hidden aria-label="Información legal pendiente">
        <ul class="flex gap-5">
          <li>
            <span title="Contenido pendiente de publicar">Privacidad<span class="sr-only"> (contenido pendiente de publicar)</span></span>
          </li>

          <li>
            <span title="Contenido pendiente de publicar">Términos<span class="sr-only"> (contenido pendiente de publicar)</span></span>
          </li>
        </ul>
      </div>
    </div>

  </div>
</footer>
<style>
  footer a:focus-visible {
    outline: 2px solid var(--accent-400);
    outline-offset: 4px;
  }
</style>
