---
import {Image} from "astro:assets";
import { getWhatsAppLink } from "@/config/contact";
import Icon from "@/components/Icon.astro";
import factoryImage from "@/assets/images/factory/lionsun-factory.png";

const benefits = [
  {
    title: "Fabricación propia",
    icon: "factory",
  },
  {
    title: "Variedad de diseños",
    icon: "design",
  },
  {
    title: "Venta por mayor y menor",
    icon: "box",
  },
  {
    title: "Envíos a todo el Perú",
    icon: "shipping",
  },
] as const;
---

<section id="nosotros"
  class="bg-brand-950 text-white"
  aria-labelledby="why-lionsun-title"
>
  <div class="grid lg:grid-cols-[0.9fr_1.1fr]">

    <!-- CONTENIDO -->
    <div
      class="
        flex items-center
        px-5 py-9
        sm:px-8 sm:py-10
        lg:justify-end lg:px-12 lg:py-8
      "
    >
      <div class="w-full max-w-xl">
        <p
          class="
            text-xs font-semibold uppercase
            tracking-[0.28em] text-accent-400
          "
        >
          ¿Por qué elegir
        </p>

        <h2
          id="why-lionsun-title"
          class="
            mt-2 text-4xl font-extrabold
            uppercase leading-[0.92]
            tracking-tight
            sm:text-5xl
          "
        >
          LIONSUN?
        </h2>

        <p
            class="
              mt-4 max-w-lg
              text-sm leading-6
              text-neutral-200
            "
          >
            Fabricamos nuestras medias directamente, cuidando cada etapa
            para ofrecer calidad, variedad y atención cercana.
          </p>

        <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-4 lg:mt-5 lg:gap-x-6 lg:gap-y-3">
          {
            benefits.map((benefit) => (
                      <li class="flex min-w-0 items-center gap-3">

          <span
            class="
              flex size-9 shrink-0
              items-center justify-center
              rounded-full
              bg-brand-800
              text-accent-400
            "
            aria-hidden="true"
          >
            <Icon name={benefit.icon} class="size-5" />
          </span>

          <h3 class="text-xs font-bold leading-tight sm:text-sm">
            {benefit.title}
          </h3>

        </li>
            ))
          }
        </ul>

        <a
          href={getWhatsAppLink()}
          class="
            mt-6 lg:mt-5  inline-flex
            items-center gap-4
            rounded-lg bg-white
            px-5 py-3
            text-sm font-bold
            text-brand-950
            transition
            hover:bg-neutral-100
            focus-visible:outline-2
            focus-visible:outline-offset-4
            focus-visible:outline-accent-400
          "
        >
          Consulta sobre LIONSUN

          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- IMAGEN -->
    <figure class="relative min-h-80 overflow-hidden lg:min-h-[480px]">
      <Image
        src={factoryImage}
        alt="Área de producción de medias LIONSUN con máquinas textiles en funcionamiento"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
      />

      <div
        class="
          pointer-events-none
          absolute inset-0
          bg-gradient-to-r
          from-brand-950/25
          via-transparent
          to-transparent
        "
        aria-hidden="true"
      >
      </div>
    </figure>

  </div>
</section>