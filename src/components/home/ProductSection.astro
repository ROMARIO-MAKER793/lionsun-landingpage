---
import { getWhatsAppLink } from "@/config/contact";
import Container from "@/components/common/Container.astro";
import ProductCard from "@/components/home/ProductCard.astro";

import productMenCrew from "@/assets/images/products/tobilleraVaronFelpa.png";
import productWomenCrew from "@/assets/images/products/tobilleraColores.png";
import productMenAnkle from "@/assets/images/products/taloneraVaron.png";
import productWomenLion from "@/assets/images/products/tobilleraDamaEntero.png";

const products = [
  {
    name: "Media deportiva",
    category: "Varón",
    badge: "Destacado",
    image: productMenCrew,
    imageAlt: "Medias deportivas LIONSUN para varón en diferentes colores",
  },
  {
    name: "Media casual dama",
    category: "Dama",
    badge: "Nuevo",
    image: productWomenCrew,
    imageAlt: "Medias LIONSUN para dama en diferentes colores",
  },
  {
    name: "Media juvenil",
    category: "Niños",
    image: productWomenLion,
    imageAlt: "Medias LION en diferentes colores",
  },
  {
    name: "Media urbana",
    category: "Varón",
    image: productMenAnkle,
    imageAlt: "Medias tobilleras LIONSUN para varón en diferentes colores",
  },
];
---

<section
  id="productos-destacados"
  class="bg-neutral-50 py-10 sm:py-12 lg:py-14"
  aria-labelledby="featured-products-title"
>
  <Container>
    <div
      class="
        flex flex-col gap-5
        md:flex-row md:items-end md:justify-between
      "
    >
      <div>
        <p
          class="
            text-[11px] font-semibold uppercase
            tracking-[0.28em] text-brand-700
          "
        >
          Productos destacados
        </p>

        <h2
          id="featured-products-title"
          class="
            mt-1.5
            text-3xl font-extrabold uppercase
            leading-[0.9] tracking-tight
            text-brand-950
            sm:text-4xl
            lg:text-[2.5rem]
          "
        >
          Lo más vendido
        </h2>
      </div>

      <a
        href={getWhatsAppLink()}
        class="
          inline-flex items-center gap-1.5
          text-xs font-semibold text-brand-700
          transition hover:text-brand-800
          focus-visible:outline-2
          focus-visible:outline-offset-4
          focus-visible:outline-accent-500
          md:mb-1
        "
      >
        Consultar más productos

        <svg
          viewBox="0 0 24 24"
          class="size-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 12h12" />
          <path d="m13 7 5 5-5 5" />
        </svg>
      </a>
    </div>

    <ul
      class="
        mt-6 grid grid-cols-2 gap-4
        lg:grid-cols-4 lg:gap-5
      "
    >
      {
  products.map((product) => (
    <ProductCard
      name={product.name}
      category={product.category}
      href={getWhatsAppLink({ kind: "product", name: product.name })}
      badge={product.badge}
      image={product.image}
      imageAlt={product.imageAlt}
    />
  ))
}
    </ul>
  </Container>
</section>