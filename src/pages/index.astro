---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnnouncementBar from "@/components/common/AnnouncementBar.astro";
import Header from "@/components/common/Header.astro";
import Hero from "@/components/home/Hero.astro";
import CategorySection from '@/components/home/CategorySection.astro';
import WhyLionsun  from '@/components/home/WhyLionsun.astro';
import ProductSection from "@/components/home/ProductSection.astro";
import WholesaleSection from '@/components/home/WholesaleSection.astro';
import Footer from "@/components/common/Footer.astro";

---

<BaseLayout
  title="LIONSUN | Medias para mayoristas y venta directa"
  description="Fabricamos y distribuimos medias para varón, dama y niños. Venta por mayor y menor con atención directa y envíos a todo el Perú."
>
  <AnnouncementBar />
  <Header />

  <main>
    <Hero />
    <CategorySection />
    <ProductSection />
    <WholesaleSection />
    <WhyLionsun />
  </main>

  <Footer />
</BaseLayout>